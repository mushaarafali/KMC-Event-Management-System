@model ResetPasswordVm

@{
    ViewData["Title"] = "Reset Password";
}

<section class="auth-page">

    <div class="auth-card">

        <div class="auth-title">

            <span class="eyebrow">
                Password Recovery
            </span>

            <h1>
                Reset Password
            </h1>

            <p>
                Enter the 6-digit code sent to your email
                and create a new password.
            </p>

        </div>

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation">
            </div>

            <input asp-for="Email"
                   type="hidden" />

            <div class="form-group">

                <label asp-for="Code">
                    Reset Code
                </label>

                <input asp-for="Code"
                       type="text"
                       maxlength="6"
                       inputmode="numeric"
                       placeholder="Enter 6-digit code" />

                <span asp-validation-for="Code"
                      class="validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="NewPassword">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       id="newPassword"
                       placeholder="Enter new password" />

                <span asp-validation-for="NewPassword"
                      class="validation">
                </span>

            </div>

            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       id="confirmPassword"
                       placeholder="Confirm new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="validation">
                </span>

            </div>

            <button type="submit"
                    class="btn primary full">

                Reset Password

            </button>

        </form>

        <div class="auth-links">

            <a asp-controller="Account"
               asp-action="Login">

                Back to Login

            </a>

        </div>

    </div>

</section>