@model List<ReservationVm>

@{
    ViewData["Title"] = "Manage Reservations";

    var totalReservations = Model.Count;
    var approved = Model.Count(x => x.ApprovalStatus == "Approved");
    var pending = Model.Count(x => x.ApprovalStatus == "Pending");
    var paid = Model.Count(x => x.PaymentStatus == "Paid");
}

<section class="dashboard-head">
    <div>
        <span class="eyebrow">Kandy Municipal Council</span>
        <h1>Manage Reservations</h1>
        <p>Monitor all public reservations, payments and organizer approvals.</p>
    </div>
</section>

<section class="stat-grid">

    <div class="stat-card">
        <strong>@totalReservations</strong>
        <span>Total Reservations</span>
    </div>

    <div class="stat-card">
        <strong>@approved</strong>
        <span>Approved</span>
    </div>

    <div class="stat-card">
        <strong>@pending</strong>
        <span>Pending Approval</span>
    </div>

    <div class="stat-card">
        <strong>@paid</strong>
        <span>Paid Reservations</span>
    </div>

</section>

<section class="dashboard-section">

    <div class="section-heading">
        <div>
            <span class="eyebrow">Booking Monitoring</span>
            <h2>All Reservations</h2>
            <p>View participant, ticket, payment and approval information.</p>
        </div>
    </div>

    <div class="responsive-table">

        <table>

            <thead>
                <tr>
                    <th>Event / Customer</th>
                    <th>Email</th>
                    <th>Ticket</th>
                    <th>Seats</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Approval</th>
                    <th>Reserved At</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Count > 0)
                {
                    @foreach (var reservation in Model)
                    {
                        <tr>

                            <td>
                                <strong>@reservation.EventTitle</strong>
                                <small>@reservation.Customer</small>
                            </td>

                            <td>
                                @reservation.Email
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(reservation.TicketCategory)
                                                        ? "-"
                                                        : reservation.TicketCategory)
                    </td>

                            <td>
                                @reservation.Quantity
                            </td>

                            <td>
                                LKR @reservation.TotalAmount.ToString("N2")
                            </td>

                            <td>
                                <strong>@reservation.PaymentMethod</strong>
                                <small>@reservation.PaymentStatus</small>
                            </td>

                            <td>
                                <span class="status @((reservation.ApprovalStatus ?? "").ToLower())">
                                    @reservation.ApprovalStatus
                                </span>
                            </td>

                            <td>
                                @reservation.ReservedAt.ToString("dd MMM yyyy hh:mm tt")
                            </td>

                        </tr>
                                }
                }
                else
                {
                    <tr>
                        <td colspan="8">No reservations found.</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>