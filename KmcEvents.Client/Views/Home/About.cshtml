@{
    ViewData["Title"] = "About";
}

<section class="page-hero about-page-hero">

    <div class="page-hero-content">

        <span class="eyebrow">
            About the Platform
        </span>

        <h1>
            Kandy's Central Event
            Management Hub
        </h1>

        <p>
            A centralized platform for discovering,
            organizing and managing events across Kandy.
        </p>

    </div>

</section>


<section class="about-section">

    <div class="about-grid">


        <!-- PUBLIC -->

        <article class="about-card">

            <div class="about-icon">
                <i class="fa-solid fa-users"></i>
            </div>

            <h2>
                For the Public
            </h2>

            <p>
                Visitors can explore published events, search by
                category, date and location, and view event details
                without creating an account.
            </p>

            <p>
                Registered public users can reserve seats, select
                ticket categories, make demo card payments or
                choose Pay Later, and receive approved QR tickets.
            </p>

        </article>


        <!-- ORGANIZERS -->

        <article class="about-card">

            <div class="about-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <h2>
                For Event Organizers
            </h2>

            <p>
                Registered organizers can manage their own events,
                ticket categories, capacity, publication status
                and participant reservations.
            </p>

            <p>
                Organizers can review reservation requests,
                approve or reject bookings and monitor event
                participation through their dashboard.
            </p>

        </article>


        <!-- ADMIN -->

        <article class="about-card">

            <div class="about-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>

            <h2>
                For KMC Administration
            </h2>

            <p>
                The KMC System Administrator centrally monitors
                registered users, organizers, events, reservations
                and platform activity.
            </p>

            <p>
                Administrative reports provide information about
                revenue, public participation and organizer
                performance.
            </p>

        </article>

    </div>

</section>


<section class="about-technology">

    <div class="about-tech-inner">

        <span class="eyebrow">
            Platform Technology
        </span>

        <h2>
            Secure Service-Oriented Event Management
        </h2>

        <p>
            The KMC Event Management Platform is developed using
            a service-oriented architecture with an ASP.NET Core
            Web API and ASP.NET Core MVC client.
        </p>

        <p>
            The reusable API provides secure services for
            authentication, event management, ticket categories,
            reservations, payments, approval workflows,
            notifications and reporting.
        </p>

    </div>

</section>