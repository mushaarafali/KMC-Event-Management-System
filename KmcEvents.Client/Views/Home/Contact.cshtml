@model ContactVm
@{
    ViewData["Title"]="Contact Us";
}
<section class="page-hero contact-page-hero">

    <div class="page-hero-content">

        <span class="eyebrow">
            Contact KMC
        </span>

        <h1>
            Get in Touch
        </h1>

        <p>
            Send an event-platform inquiry or find
            Kandy Municipal Council on the map.
        </p>

    </div>

</section>
<section class="contact-section">
    <div class="contact-grid">
        <div class="map-card">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2239.77294162914!2d80.63634748528656!3d7.2981909838642585!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3ae367d4bd597f23%3A0xa7d98392523d50f8!2sKandy%20Municipal%20Council!5e1!3m2!1sen!2slk!4v1786498258372!5m2!1sen!2slk" width="600" height="450" style="border:0" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin">
            </iframe>
        </div>
        <form class="form-card" method="post">
            <h2>Send Message</h2>
            <div asp-validation-summary="ModelOnly" class="validation">
            </div>
            <label asp-for="Name">
            </label>
            <input asp-for="Name"/>
            <span asp-validation-for="Name" class="validation">
            </span>
            <label asp-for="Email">
            </label>
            <input asp-for="Email"/>
            <span asp-validation-for="Email" class="validation">
            </span>
            <label asp-for="Subject">
            </label>
            <input asp-for="Subject"/>
            <span asp-validation-for="Subject" class="validation">
            </span>
            <label asp-for="Message">
            </label>
            <textarea asp-for="Message" rows="6">
            </textarea>
            <span asp-validation-for="Message" class="validation">
            </span>
            <button class="btn primary" type="submit">Send Message</button>
        </form>
    </div>
</section>
