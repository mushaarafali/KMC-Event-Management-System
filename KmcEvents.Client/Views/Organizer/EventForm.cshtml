@model EventVm

@{
    var edit = Model.Id > 0;

    ViewData["Title"] =
        edit
            ? "Edit Event"
            : "Create Event";
}

<section class="page-hero compact">

    <span class="eyebrow">
        Organizer Event Management
    </span>

    <h1>
        @(edit ? "Edit Event" : "Create New Event")
    </h1>

    <p>
        Event date must be at least 10 days from today.
        Ticket seat limits must remain within total capacity.
    </p>

</section>

<section class="form-section">

    <form class="form-card event-form"
          method="post" enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="validation">
        </div>

        <input asp-for="Id"
               type="hidden" />

        <div class="two-col">

            <div>

                <label asp-for="Title">
                    Event Title
                </label>

                <input asp-for="Title"
                       placeholder="Enter event title" />

                <span asp-validation-for="Title"
                      class="validation">
                </span>

            </div>

            <div>

                <label asp-for="Category">
                    Event Category
                </label>

                <select asp-for="Category">

                    <option value="">
                        Select Category
                    </option>

                    <option value="Culture">
                        Culture
                    </option>

                    <option value="Music">
                        Music
                    </option>

                    <option value="Food">
                        Food
                    </option>

                    <option value="Sports">
                        Sports
                    </option>

                    <option value="Education">
                        Education
                    </option>

                    <option value="Community">
                        Community
                    </option>

                    <option value="Business">
                        Business
                    </option>

                    <option value="Religious">
                        Religious
                    </option>

                    <option value="Entertainment">
                        Entertainment
                    </option>

                </select>

                <span asp-validation-for="Category"
                      class="validation">
                </span>

            </div>

        </div>

        <div>

            <label asp-for="Description">
                Description
            </label>

            <textarea asp-for="Description"
                      rows="6"
                      placeholder="Enter event description">
            </textarea>

            <span asp-validation-for="Description"
                  class="validation">
            </span>

        </div>

        <div class="two-col">

            <div>

                <label asp-for="Location">
                    Location
                </label>

                <input asp-for="Location"
                       placeholder="Enter event location" />

                <span asp-validation-for="Location"
                      class="validation">
                </span>

            </div>

            <div>

                <label asp-for="Capacity">
                    Total Capacity
                </label>

                <input asp-for="Capacity"
                       type="number"
                       min="1"
                       placeholder="Enter total capacity" />

                <span asp-validation-for="Capacity"
                      class="validation">
                </span>

            </div>

        </div>

        <div class="two-col">

            <div>

                <label asp-for="EventDate">
                    Event Date & Time
                </label>

                <input asp-for="EventDate"
                       type="datetime-local"
                       step="60"
                       value="@Model.EventDate.ToString("yyyy-MM-ddTHH:mm")" />

                <span asp-validation-for="EventDate"
                      class="validation">
                </span>

            </div>

            <div>

                <label asp-for="RegistrationCloseDate">
                    Registration Close
                </label>

                <input asp-for="RegistrationCloseDate"
                       type="datetime-local"
                       step="60"
                       value="@Model.RegistrationCloseDate.ToString("yyyy-MM-ddTHH:mm")" />

                <span asp-validation-for="RegistrationCloseDate"
                      class="validation">
                </span>

            </div>

        </div>

        <div>

            <label asp-for="ImageFile">
                Event Image
            </label>

            <input asp-for="ImageFile"
                   type="file"
                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                   class="form-control" />

            <small class="form-help">
                JPG, JPEG, PNG or WEBP. Maximum file size: 5 MB.
            </small>

        </div>

        <div class="ticket-section">

            <h3>
                Ticket Categories
            </h3>

            <p class="form-note">
                Add up to three ticket categories.
                The total seat allocation must not exceed the event capacity.
            </p>

            <div class="ticket-editor">

                @for (int i = 0; i < 3; i++)
                {
                    var ticket =
                    i < Model.TicketCategories.Count
                    ? Model.TicketCategories[i]
                    : new TicketVm();

                    <div class="ticket-row">

                        <input type="hidden"
                               name="TicketCategories[@i].Id"
                               value="@ticket.Id" />

                        <div>

                            <label>
                                Ticket Category
                            </label>

                            <input name="TicketCategories[@i].Name"
                                   value="@ticket.Name"
                                   placeholder="General / VIP / Premium" />

                        </div>

                        <div>

                            <label>
                                Ticket Price
                            </label>

                            <input name="TicketCategories[@i].Price"
                                   value="@ticket.Price"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   placeholder="Price" />

                        </div>

                        <div>

                            <label>
                                Seat Limit
                            </label>

                            <input name="TicketCategories[@i].SeatLimit"
                                   value="@ticket.SeatLimit"
                                   type="number"
                                   min="0"
                                   placeholder="Seat limit" />

                        </div>

                    </div>
                }

            </div>

        </div>

        <label class="check">

            <input asp-for="IsPublished" />

            <span>
                Publish event immediately
            </span>

        </label>

        <div class="form-actions">

            <a asp-controller="Organizer"
               asp-action="Dashboard"
               class="btn secondary">

                Cancel

            </a>

            <button class="btn primary"
                    type="submit">

                @(edit ? "Save Changes" : "Create Event")

            </button>

        </div>

    </form>

</section>
